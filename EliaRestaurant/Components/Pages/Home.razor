@page "/"

@* Название вкладки браузера *@
<PageTitle>ÉLIA Restaurant</PageTitle>

@* Главная страница ресторана *@
<div class="home-page">

    @* Приветственный блок *@
    <div class="welcome">

        <p class="subtitle">RESTAURANT & ATMOSPHERE</p>

        <h1>Добро пожаловать в ÉLIA</h1>

        <p>
            Место, где вкус встречается с атмосферой.
            Проведите особенный вечер вместе с нами.
        </p>

        @* Переход на страницу бронирования *@
        <a href="/booking" class="main-button">
            Забронировать столик
        </a>

    </div>

    @* Информация о ресторане *@
    <div class="restaurant-info">

        <h2>О нашем ресторане</h2>

        <p>
            Уютная атмосфера, вкусная еда
            и приятная компания.
        </p>

        <h3>Время работы</h3>

        <p>Ежедневно с 12:00 до 22:00</p>

    </div>

</div>